{
  "name": "keel-cli",
  "version": "1.1.0",
  "description": "Repo rules, task specs, session memory, and verification gates for coding agents.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/pdxxxx/keel#readme",
  "bugs": {
    "url": "https://github.com/pdxxxx/keel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdxxxx/keel.git"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "mcp",
    "cli",
    "agents-md",
    "rules",
    "memory",
    "verification",
    "keel"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "keel": "./bin/keel.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README_CN.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
